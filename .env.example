# Copy this file to ".env" and fill in values ONLY if you want the optional Azure AI provider.
# The app works fully without any of these. NEVER commit your real .env file.
SHIFTCAST_USE_AZURE=false
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=PUT_YOUR_KEY_HERE
AZURE_OPENAI_DEPLOYMENT=YOUR_CHAT_MODEL_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-10-21
